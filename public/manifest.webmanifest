{
  "name": "AlphaForge",
  "short_name": "AlphaForge",
  "description": "Options command center: levels, plans, and alerts for same-day calls and puts.",
  "start_url": "/options",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#070b13",
  "theme_color": "#070b13",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Options terminal", "url": "/options", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My board", "url": "/board", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
