# ─────────────────────────────────────────────────────────
# AlphaForge environment variables
# Copy this file to `.env.local` and fill in as you get each key.
# The app runs on MOCK DATA until these are set — nothing breaks
# if they are blank, you just won't see live market data yet.
# ─────────────────────────────────────────────────────────

# Neon Postgres (Phase 1) — https://console.neon.tech → project → Connection string
DATABASE_URL=

# Polygon.io (Phase 1) — https://polygon.io  → Dashboard → API Keys
POLYGON_API_KEY=

# FRED (Phase 1, free) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Anthropic Claude (Phase 2) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Financial Modeling Prep (Phase 2) — https://site.financialmodelingprep.com
FMP_API_KEY=

# Benzinga (Phase 2) — https://www.benzinga.com/apis
BENZINGA_API_KEY=

# NewsAPI (Phase 2) — https://newsapi.org
NEWSAPI_KEY=

# Resend email alerts (Phase 2) — https://resend.com
RESEND_API_KEY=

# Cron auth — any random string; protects /api/scan from public calls
CRON_SECRET=

# Site passcode gate (Phase 1) — any string; site is open when unset
SITE_PASSCODE=
